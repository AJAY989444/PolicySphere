// Prisma Schema for PolicySphere
// This schema will grow incrementally as features are built.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User & Auth ───────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  phone         String?
  role          Role     @default(CUSTOMER)
  isActive      Boolean  @default(true) @map("is_active")
  notificationPreferences Json?   @default("{\"email\": true, \"sms\": false, \"inApp\": true, \"claims\": true, \"renewals\": true, \"marketing\": false}") @map("notification_preferences")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  userPolicies  UserPolicy[]
  payments      PaymentTransaction[]
  notifications Notification[]
  proposals     Proposal[]
  assignedLeads  Lead[]               @relation("AdvisorLeads")
  leadActivities LeadActivity[]
  commissions    AdvisorCommission[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum Role {
  CUSTOMER
  ADVISOR
  ADMIN
}

enum InsuranceCategory {
  HEALTH
  LIFE
  MOTOR
  TRAVEL
  HOME
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum ClaimStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

// ─── Insurance Catalog ─────────────────────────────────────

model InsurancePolicy {
  id             String            @id @default(cuid())
  name           String
  provider       String
  category       InsuranceCategory
  description    String
  coverageAmount Float             @map("coverage_amount")
  premium        Float
  duration       Int               // duration in months
  features       Json              @default("[]")
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  userPolicies UserPolicy[]
  proposals    Proposal[]

  @@map("insurance_policies")
}

// ─── Proposal Management & Digital Application Workflow ───

enum ProposalStatus {
  DRAFT
  PENDING_UNDERWRITING
  APPROVED
  REJECTED
  CONVERTED_TO_POLICY
}

model Proposal {
  id                String         @id @default(cuid())
  proposalRef       String         @unique @map("proposal_ref")
  userId            String         @map("user_id")
  policyId          String         @map("policy_id")
  status            ProposalStatus @default(DRAFT)
  step              Int            @default(1)
  proposerInfo      Json           @default("{}") @map("proposer_info")
  membersInfo       Json           @default("[]") @map("members_info")
  medicalHistory    Json           @default("{}") @map("medical_history")
  nomineeInfo       Json           @default("{}") @map("nominee_info")
  lockedPremium     Float?         @map("locked_premium")
  premiumExpiresAt  DateTime?      @map("premium_expires_at")
  underwritingFlags Json           @default("{}") @map("underwriting_flags")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@map("proposals")
}

model UserPolicy {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  policyId    String       @map("policy_id")
  status      PolicyStatus @default(ACTIVE)
  startDate   DateTime     @default(now()) @map("start_date")
  endDate     DateTime     @map("end_date")
  premiumPaid Float        @map("premium_paid")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy   InsurancePolicy      @relation(fields: [policyId], references: [id])
  claims   Claim[]
  payments PaymentTransaction[]

  @@map("user_policies")
}

// ─── Claims Management ─────────────────────────────────────

model Claim {
  id            String      @id @default(cuid())
  userPolicyId  String      @map("user_policy_id")
  status        ClaimStatus @default(PENDING)
  amount        Float
  description   String
  incidentDate  DateTime    @map("incident_date")
  documents     Json        @default("[]")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  userPolicy    UserPolicy  @relation(fields: [userPolicyId], references: [id], onDelete: Cascade)

  @@map("claims")
}

// ─── Payments & Billing ────────────────────────────────────

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
  REFUNDED
}

model PaymentTransaction {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  userPolicyId   String?       @map("user_policy_id")
  amount         Float
  currency       String        @default("USD")
  paymentMethod  String        @map("payment_method") // CARD, NET_BANKING, UPI, PAYPAL
  paymentStatus  PaymentStatus @default(SUCCESS) @map("payment_status")
  transactionRef String        @unique @map("transaction_ref")
  createdAt      DateTime      @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPolicy UserPolicy? @relation(fields: [userPolicyId], references: [id])

  @@map("payment_transactions")
}

// ─── Notifications ─────────────────────────────────────────

enum NotificationType {
  CLAIM_UPDATE
  PAYMENT_SUCCESS
  POLICY_ISSUED
  RENEWAL_REMINDER
  KYC_UPDATE
  PROPOSAL_LOCK_EXPIRING
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false) @map("is_read")
  linkUrl   String?          @map("link_url")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── CRM & Advisor Management ──────────────────────────────

enum LeadStage {
  NEW
  CONTACTED
  QUOTE_SENT
  PROPOSAL_IN_PROGRESS
  CONVERTED
  LOST
}

model Lead {
  id               String            @id @default(cuid())
  advisorId        String?           @map("advisor_id")
  name             String
  email            String
  phone            String
  category         InsuranceCategory @default(HEALTH)
  estimatedBudget  Float?            @map("estimated_budget")
  stage            LeadStage         @default(NEW)
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  advisor          User?             @relation("AdvisorLeads", fields: [advisorId], references: [id], onDelete: SetNull)
  activities       LeadActivity[]

  @@map("leads")
}

model LeadActivity {
  id          String   @id @default(cuid())
  leadId      String   @map("lead_id")
  advisorId   String   @map("advisor_id")
  type        String   // NOTE, CALL, EMAIL, MEETING, STAGE_CHANGE
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  lead    Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  advisor User @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@map("lead_activities")
}

model AdvisorCommission {
  id               String   @id @default(cuid())
  advisorId        String   @map("advisor_id")
  policyName       String   @map("policy_name")
  premiumAmount    Float    @map("premium_amount")
  commissionRate   Float    @default(0.10) @map("commission_rate")
  commissionAmount Float    @map("commission_amount")
  status           String   @default("PENDING") // PENDING, APPROVED, PAID
  createdAt        DateTime @default(now()) @map("created_at")

  advisor User @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@map("advisor_commissions")
}


