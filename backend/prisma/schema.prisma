// Prisma Schema for PolicySphere
// This schema will grow incrementally as features are built.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User & Auth ───────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  phone         String?
  role          Role     @default(CUSTOMER)
  isActive      Boolean  @default(true) @map("is_active")
  notificationPreferences Json?   @default("{\"email\": true, \"sms\": false, \"inApp\": true, \"claims\": true, \"renewals\": true, \"marketing\": false}") @map("notification_preferences")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  userPolicies  UserPolicy[]
  payments      PaymentTransaction[]
  notifications Notification[]
  deliveryLogs  NotificationDeliveryLog[]
  proposals     Proposal[]
  assignedLeads  Lead[]               @relation("AdvisorLeads")
  leadActivities LeadActivity[]
  commissions    AdvisorCommission[]
  leadFollowUps  LeadFollowUp[]
  leadCalls      LeadCall[]
  leadMeetings   LeadMeeting[]
  leadEmailLogs  LeadEmailLog[]
  underwritingAssessments UnderwritingAssessment[]
  refunds        RefundTransaction[]
  aiAssessments  AIAssessmentLog[]
  searchLogs     SearchQueryLog[]
  supportTicketsCreated  SupportTicket[]       @relation("CustomerTickets")
  supportTicketsAssigned SupportTicket[]       @relation("AssignedAgentTickets")
  ticketMessagesSent     TicketMessage[]
  reportsGenerated       GeneratedReport[]
  auditLogs              AuditLog[]
  corporateAccounts      CorporateAccount[]
  corporateEmployees     CorporateEmployee[]
  consents               UserConsent[]
  erasureRequests        DataErasureRequest[]
  fraudAssessments       FraudRiskAssessment[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum Role {
  CUSTOMER
  ADVISOR
  ADMIN
}

enum InsuranceCategory {
  HEALTH
  LIFE
  MOTOR
  TRAVEL
  HOME
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum ClaimStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

// ─── Insurance Catalog ─────────────────────────────────────

model InsurancePolicy {
  id             String            @id @default(cuid())
  name           String
  provider       String
  category       InsuranceCategory
  description    String
  coverageAmount Float             @map("coverage_amount")
  premium        Float
  duration       Int               // duration in months
  features       Json              @default("[]")
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  userPolicies UserPolicy[]
  proposals    Proposal[]
  underwritingAssessments UnderwritingAssessment[]

  @@map("insurance_policies")
}

// ─── Proposal Management & Digital Application Workflow ───

enum ProposalStatus {
  DRAFT
  PENDING_UNDERWRITING
  APPROVED
  REJECTED
  CONVERTED_TO_POLICY
}

model Proposal {
  id                String         @id @default(cuid())
  proposalRef       String         @unique @map("proposal_ref")
  userId            String         @map("user_id")
  policyId          String         @map("policy_id")
  status            ProposalStatus @default(DRAFT)
  step              Int            @default(1)
  proposerInfo      Json           @default("{}") @map("proposer_info")
  membersInfo       Json           @default("[]") @map("members_info")
  medicalHistory    Json           @default("{}") @map("medical_history")
  nomineeInfo       Json           @default("{}") @map("nominee_info")
  lockedPremium     Float?         @map("locked_premium")
  premiumExpiresAt  DateTime?      @map("premium_expires_at")
  underwritingFlags Json           @default("{}") @map("underwriting_flags")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  underwritingAssessment UnderwritingAssessment?

  @@map("proposals")
}

model UserPolicy {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  policyId    String       @map("policy_id")
  status      PolicyStatus @default(ACTIVE)
  startDate   DateTime     @default(now()) @map("start_date")
  endDate     DateTime     @map("end_date")
  premiumPaid Float        @map("premium_paid")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy   InsurancePolicy      @relation(fields: [policyId], references: [id])
  claims   Claim[]
  payments PaymentTransaction[]

  @@map("user_policies")
}

// ─── Claims Management ─────────────────────────────────────

model Claim {
  id            String      @id @default(cuid())
  userPolicyId  String      @map("user_policy_id")
  status        ClaimStatus @default(PENDING)
  amount        Float
  description   String
  incidentDate  DateTime    @map("incident_date")
  documents     Json        @default("[]")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  userPolicy    UserPolicy  @relation(fields: [userPolicyId], references: [id], onDelete: Cascade)
  fraudAssessment ClaimFraudAssessment?

  @@map("claims")
}

// ─── Payments & Billing ────────────────────────────────────

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
  REFUNDED
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
  UPI_AUTOPAY
  NET_BANKING
}

enum RefundStatus {
  NONE
  PARTIAL
  FULL
}

enum RefundReason {
  CANCELLED_POLICY
  DUPLICATE_PAYMENT
  UNDERWRITING_REJECTED
  OVERPAYMENT
  CUSTOMER_REQUEST
}

model PaymentTransaction {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  userPolicyId   String?        @map("user_policy_id")
  amount         Float
  currency       String         @default("USD")
  paymentMethod  String         @map("payment_method") // CARD, NET_BANKING, UPI, EMI
  paymentGateway PaymentGateway @default(RAZORPAY) @map("payment_gateway")
  gatewayTxnId   String?        @map("gateway_txn_id")
  paymentStatus  PaymentStatus  @default(SUCCESS) @map("payment_status")
  refundStatus   RefundStatus   @default(NONE) @map("refund_status")
  totalRefunded  Float          @default(0) @map("total_refunded")
  transactionRef String         @unique @map("transaction_ref")
  createdAt      DateTime       @default(now()) @map("created_at")

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPolicy UserPolicy?         @relation(fields: [userPolicyId], references: [id])
  refunds    RefundTransaction[]

  @@map("payment_transactions")
}

model RefundTransaction {
  id              String       @id @default(cuid())
  refundRef       String       @unique @map("refund_ref")
  transactionId   String       @map("transaction_id")
  userId          String       @map("user_id")
  amount          Float
  reason          RefundReason @default(CUSTOMER_REQUEST)
  status          String       @default("COMPLETED") // COMPLETED, PENDING, FAILED
  gatewayRefundId String?      @map("gateway_refund_id")
  notes           String?
  createdAt       DateTime     @default(now()) @map("created_at")

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refund_transactions")
}

model PaymentReconciliationLog {
  id                String   @id @default(cuid())
  reconciliationRef String   @unique @map("reconciliation_ref")
  runDate           DateTime @default(now()) @map("run_date")
  totalTransactions Int      @map("total_transactions")
  totalAmount       Float    @map("total_amount")
  matchedCount      Int      @map("matched_count")
  discrepancyCount  Int      @map("discrepancy_count")
  status            String   @default("SUCCESS") // SUCCESS, DISCREPANCY_FLAGGED
  reportSummary     Json     @default("{}") @map("report_summary")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("payment_reconciliation_logs")
}

// ─── Notifications ─────────────────────────────────────────

enum NotificationType {
  OTP
  PURCHASE
  RENEWAL
  CLAIM_UPDATE
  PAYMENT_SUCCESS
  REMINDER
  POLICY_ISSUED
  RENEWAL_REMINDER
  KYC_UPDATE
  PROPOSAL_LOCK_EXPIRING
  SYSTEM
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

model Notification {
  id        String              @id @default(cuid())
  userId    String              @map("user_id")
  title     String
  message   String
  type      NotificationType    @default(SYSTEM)
  channel   NotificationChannel @default(IN_APP)
  isRead    Boolean             @default(false) @map("is_read")
  linkUrl   String?             @map("link_url")
  createdAt DateTime            @default(now()) @map("created_at")

  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryLogs NotificationDeliveryLog[]

  @@map("notifications")
}

model NotificationDeliveryLog {
  id               String              @id @default(cuid())
  userId           String              @map("user_id")
  notificationId   String?             @map("notification_id")
  channel          NotificationChannel
  eventType        NotificationType    @map("event_type")
  recipient        String
  subject          String
  contentSnippet   String              @map("content_snippet")
  status           DeliveryStatus      @default(DELIVERED)
  deliveryMetadata Json                @default("{}") @map("delivery_metadata")
  createdAt        DateTime            @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@map("notification_delivery_logs")
}

// ─── CRM & Advisor Management ──────────────────────────────

enum LeadStage {
  NEW
  CONTACTED
  QUOTE_SENT
  PROPOSAL_IN_PROGRESS
  CONVERTED
  LOST
}

enum LeadPriority {
  HOT
  WARM
  COLD
}

enum LeadSource {
  CATALOG_INQUIRY
  SMART_ADVISOR
  LANDING_PAGE
  REFERRAL
  MANUAL
}

enum CustomerSentiment {
  READY_TO_BUY
  INTERESTED
  HESITANT
  PRICE_SENSITIVE
  NOT_INTERESTED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
  CANCELLED
}

enum FollowUpPriority {
  HIGH
  MEDIUM
  LOW
}

enum CallOutcome {
  CONNECTED
  BUSY
  VOICEMAIL
  SCHEDULED_CALLBACK
  WRONG_NUMBER
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum EmailStatus {
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
}

model Lead {
  id               String            @id @default(cuid())
  advisorId        String?           @map("advisor_id")
  name             String
  email            String
  phone            String
  category         InsuranceCategory @default(HEALTH)
  estimatedBudget  Float?            @map("estimated_budget")
  stage            LeadStage         @default(NEW)
  source           LeadSource        @default(CATALOG_INQUIRY)
  priority         LeadPriority      @default(WARM)
  leadScore        Int               @default(50) @map("lead_score")
  sentiment        CustomerSentiment @default(INTERESTED)
  pinnedNotes      String?           @map("pinned_notes")
  policyId         String?           @map("policy_id")
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  advisor          User?             @relation("AdvisorLeads", fields: [advisorId], references: [id], onDelete: SetNull)
  activities       LeadActivity[]
  followUps        LeadFollowUp[]
  calls            LeadCall[]
  meetings         LeadMeeting[]
  emailLogs        LeadEmailLog[]

  @@map("leads")
}

model LeadActivity {
  id          String   @id @default(cuid())
  leadId      String   @map("lead_id")
  advisorId   String   @map("advisor_id")
  type        String   // NOTE, CALL, EMAIL, MEETING, STAGE_CHANGE, REASSIGNMENT
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  lead    Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  advisor User @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@map("lead_activities")
}

model LeadFollowUp {
  id               String         @id @default(cuid())
  leadId           String         @map("lead_id")
  advisorId        String         @map("advisor_id")
  title            String
  scheduledAt      DateTime       @map("scheduled_at")
  priority         FollowUpPriority @default(MEDIUM)
  status           FollowUpStatus @default(PENDING)
  notes            String?
  completedAt      DateTime?      @map("completed_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  lead    Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  advisor User @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@map("lead_follow_ups")
}

model LeadCall {
  id               String      @id @default(cuid())
  leadId           String      @map("lead_id")
  advisorId        String      @map("advisor_id")
  durationSeconds  Int         @default(0) @map("duration_seconds")
  outcome          CallOutcome @default(CONNECTED)
  notes            String?
  recordingUrl     String?     @map("recording_url")
  createdAt        DateTime    @default(now()) @map("created_at")

  lead    Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  advisor User @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@map("lead_calls")
}

model LeadMeeting {
  id               String        @id @default(cuid())
  leadId           String        @map("lead_id")
  advisorId        String        @map("advisor_id")
  title            String
  scheduledAt      DateTime      @map("scheduled_at")
  durationMinutes  Int           @default(30) @map("duration_minutes")
  meetingLink      String?       @map("meeting_link")
  agenda           String?
  status           MeetingStatus @default(SCHEDULED)
  outcomeNotes     String?       @map("outcome_notes")
  createdAt        DateTime      @default(now()) @map("created_at")

  lead    Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  advisor User @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@map("lead_meetings")
}

model LeadEmailLog {
  id               String      @id @default(cuid())
  leadId           String      @map("lead_id")
  advisorId        String      @map("advisor_id")
  recipientEmail   String      @map("recipient_email")
  subject          String
  body             String
  templateName     String?     @map("template_name")
  status           EmailStatus @default(SENT)
  openedAt         DateTime?   @map("opened_at")
  clickedAt        DateTime?   @map("clicked_at")
  createdAt        DateTime    @default(now()) @map("created_at")

  lead    Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  advisor User @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@map("lead_email_logs")
}

model AdvisorCommission {
  id               String   @id @default(cuid())
  advisorId        String   @map("advisor_id")
  policyName       String   @map("policy_name")
  premiumAmount    Float    @map("premium_amount")
  commissionRate   Float    @default(0.10) @map("commission_rate")
  commissionAmount Float    @map("commission_amount")
  status           String   @default("PENDING") // PENDING, APPROVED, PAID
  createdAt        DateTime @default(now()) @map("created_at")

  advisor User @relation(fields: [advisorId], references: [id], onDelete: Cascade)

  @@map("advisor_commissions")
}

// ─── Automated Underwriting & Compliance Engine ────────────

enum UnderwritingRiskLevel {
  LOW
  MEDIUM
  HIGH
  DECLINED
}

enum UnderwritingAssessmentStatus {
  AUTO_APPROVED
  PENDING_REVIEW
  COUNTER_OFFERED
  APPROVED_WITH_LOADING
  REJECTED
}

model UnderwritingAssessment {
  id               String                       @id @default(cuid())
  proposalId       String                       @unique @map("proposal_id")
  userId           String                       @map("user_id")
  policyId         String                       @map("policy_id")
  riskScore        Float                        @map("risk_score")
  riskLevel        UnderwritingRiskLevel        @map("risk_level")
  appliedLoading   Float                        @default(0.0) @map("applied_loading")
  basePremium      Float                        @map("base_premium")
  finalPremium     Float                        @map("final_premium")
  riskFactors      Json                         @default("[]") @map("risk_factors")
  status           UnderwritingAssessmentStatus @default(PENDING_REVIEW)
  underwriterNotes String?                      @map("underwriter_notes")
  riderExclusions  Json                         @default("[]") @map("rider_exclusions")
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  proposal  Proposal            @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy    InsurancePolicy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  auditLogs ComplianceAuditLog[]

  @@map("underwriting_assessments")
}

model ComplianceAuditLog {
  id               String   @id @default(cuid())
  assessmentId     String?  @map("assessment_id")
  proposalId       String?  @map("proposal_id")
  actorId          String?  @map("actor_id")
  action           String
  ruleTriggered    String?  @map("rule_triggered")
  compliancePassed Boolean  @default(true) @map("compliance_passed")
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")

  assessment UnderwritingAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@map("compliance_audit_logs")
}

// ─── AI Engine & Predictive Analytics ──────────────────────

enum FraudRiskLevel {
  LOW
  ELEVATED
  HIGH_RISK
  CRITICAL
}

model AIAssessmentLog {
  id             String   @id @default(cuid())
  userId         String?  @map("user_id")
  assessmentType String   @map("assessment_type") // RECOMMENDATION, RISK_SCORE, PREMIUM_PREDICTION, CLAIM_PROBABILITY, FRAUD_ANALYSIS
  inputData      Json     @map("input_data")
  resultData     Json     @map("result_data")
  createdAt      DateTime @default(now()) @map("created_at")

  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("ai_assessment_logs")
}

model ClaimFraudAssessment {
  id              String         @id @default(cuid())
  claimId         String?        @unique @map("claim_id")
  proposalId      String?        @map("proposal_id")
  fraudScore      Float          @map("fraud_score") // 0.0 to 100.0
  riskTier        FraudRiskLevel @default(LOW) @map("risk_tier")
  indicators      Json           @default("[]") // Array of detected red flags / anomalies
  recommendation  String         // e.g. "FAST_TRACK_APPROVED", "MANUAL_INVESTIGATION", "REJECT_SUSPICIOUS"
  analysisDetails Json           @default("{}") @map("analysis_details")
  reviewedBy      String?        @map("reviewed_by")
  reviewedAt      DateTime?      @map("reviewed_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  claim           Claim?         @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@map("claim_fraud_assessments")
}

// ─── Module 16: Search Engine ──────────────────────────────

model SearchQueryLog {
  id                 String             @id @default(cuid())
  userId             String?            @map("user_id")
  query              String
  cleanedQuery       String?            @map("cleaned_query")
  intent             String?            @default("KEYWORD") // KEYWORD, AI_SEMANTIC, CATEGORY, SYNONYM, VOICE
  matchedCategory    InsuranceCategory? @map("matched_category")
  resultsCount       Int                @default(0) @map("results_count")
  executionMs        Int                @default(0) @map("execution_ms")
  hasTypoCorrection  Boolean            @default(false) @map("has_typo_correction")
  correctedQuery     String?            @map("corrected_query")
  userAgent          String?            @map("user_agent")
  createdAt          DateTime           @default(now()) @map("created_at")

  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([query])
  @@index([createdAt])
  @@map("search_query_logs")
}

// ─── Module 18: Support Center ──────────────────────────────

enum SupportCategory {
  POLICY_INQUIRY
  CLAIM_ASSISTANCE
  PAYMENT_BILLING
  ENDORSEMENT
  RENEWAL
  CANCELLATION_REFUND
  KYC_VERIFICATION
  TECHNICAL_SUPPORT
  GRIEVANCE
  GENERAL
}

enum TicketPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportChannel {
  PORTAL
  LIVE_CHAT
  WHATSAPP
  VOICE
  EMAIL
}

enum EscalationTier {
  TIER_1_AGENT
  TIER_2_SPECIALIST
  TIER_3_MANAGEMENT
}

enum MessageSenderType {
  CUSTOMER
  AGENT
  SYSTEM_AI
}

enum ChatSessionStatus {
  ACTIVE
  TRANSFERRED_TO_TICKET
  CLOSED
}

enum CallbackStatus {
  REQUESTED
  COMPLETED
  CANCELLED
}

model SupportTicket {
  id                   String           @id @default(cuid())
  ticketNumber         String           @unique @map("ticket_number")
  userId               String           @map("user_id")
  assignedToId         String?          @map("assigned_to_id")
  category             SupportCategory  @default(GENERAL)
  priority             TicketPriority   @default(MEDIUM)
  status               TicketStatus     @default(OPEN)
  channel              SupportChannel   @default(PORTAL)
  subject              String
  description          String           @db.Text
  relatedPolicyId      String?          @map("related_policy_id")
  relatedClaimId       String?          @map("related_claim_id")
  slaFirstResponseDue  DateTime         @map("sla_first_response_due")
  slaResolutionDue     DateTime         @map("sla_resolution_due")
  firstResponseAt      DateTime?        @map("first_response_at")
  resolvedAt           DateTime?        @map("resolved_at")
  slaBreached          Boolean          @default(false) @map("sla_breached")
  escalationTier       EscalationTier   @default(TIER_1_AGENT) @map("escalation_tier")
  escalationReason     String?          @map("escalation_reason")
  csatRating           Int?             @map("csat_rating")
  csatFeedback         String?          @map("csat_feedback")
  tags                 Json             @default("[]")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  user                 User             @relation("CustomerTickets", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo           User?            @relation("AssignedAgentTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages             TicketMessage[]
  escalationLogs       TicketEscalationLog[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([slaBreached])
  @@index([createdAt])
  @@map("support_tickets")
}

model TicketMessage {
  id             String            @id @default(cuid())
  ticketId       String            @map("ticket_id")
  senderId       String?           @map("sender_id")
  senderType     MessageSenderType @default(CUSTOMER) @map("sender_type")
  isInternalNote Boolean           @default(false) @map("is_internal_note")
  message        String            @db.Text
  attachments    Json              @default("[]")
  createdAt      DateTime          @default(now()) @map("created_at")

  ticket         SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
