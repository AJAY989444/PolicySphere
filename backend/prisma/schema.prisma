  updatedAt      DateTime      @updatedAt @map("updated_at")

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("data_erasure_requests")
}

// ─── Module 33: Autonomous Fraud Detection Engine ──────────

enum FraudDecision {
  AUTO_CLEARED
  FLAGGED_FOR_INVESTIGATION
  BLOCKED_FRAUD
}

model FraudRiskAssessment {
  id          String         @id @default(cuid())
  claimId     String?        @map("claim_id")
  userId      String         @map("user_id")
  claimAmount Float          @default(0.0) @map("claim_amount")
  riskScore   Int            @map("risk_score") // 0 to 100
  riskLevel   FraudRiskLevel @map("risk_level")
  signals     Json           @map("signals")
  decision    FraudDecision  @default(AUTO_CLEARED)
  assessedAt  DateTime       @default(now()) @map("assessed_at")

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([claimId])
  @@index([riskLevel])
  @@map("fraud_risk_assessments")
}

// ─── Module 34: Universal National Integrations & Geo Hospitals ─

model NetworkHospital {
  id                 String   @id @default(cuid())
  name               String
  rohiniCode         String?  @unique @map("rohini_code")
  address            String
  city               String
  state              String
  pincode            String
  phone              String
  cashlessDeskPhone  String?  @map("cashless_desk_phone")
  rating             Float    @default(4.5)
  specialties        Json     @default("[]")
  tiers              Json     @default("[\"TIER_1\", \"TIER_2\"]")
  latitude           Float?
  longitude          Float?
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([city])
  @@index([pincode])
  @@map("network_hospitals")
}

model NationalVerificationLog {
  id             String   @id @default(cuid())
  userId         String?  @map("user_id")
  serviceType    String   @map("service_type") // DIGILOCKER, PAN_NSDL, AADHAAR_EKYC, CKYC
  identifierHash String   @map("identifier_hash")
  status         String   // SUCCESS, FAILED
  resultData     Json     @map("result_data")
  verifiedAt     DateTime @default(now()) @map("verified_at")

  @@index([serviceType])
  @@index([identifierHash])
  @@map("national_verification_logs")
}





