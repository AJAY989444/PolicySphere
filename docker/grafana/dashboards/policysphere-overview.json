  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Throughput (req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (status)",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "95th Percentile Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Latency (s)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Heap Memory Usage",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "nodejs_memory_heap_used_bytes / 1024 / 1024",
          "legendFormat": "Heap (MB)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Immutable Audit Ledger Records",
